CONSOLE_DOMAIN=console.example.com
CONSOLE_JWT_SECRET=        # openssl rand -hex 32
ORCHESTRATION_SECRET=      # openssl rand -hex 32; internal Console-to-daemon bearer
CONSOLE_ADMIN_EMAIL=admin@example.com
# base64-encoded bcrypt hash (raw '$' hash breaks Compose interpolation):
CONSOLE_ADMIN_PASSWORD_HASH_B64=  # node -e "console.log(Buffer.from(require('bcryptjs').hashSync('yourpw',10)).toString('base64'))"
CONSOLE_ADMIN_PASSWORD_TEMPORARY=false

# First-party images are built locally by setup.sh and keep release tags.
API_IMAGE=motherbase-api:1.0.0
CONSOLE_IMAGE=motherbase-console:1.0.0
ORCHESTRATION_IMAGE=motherbase-orchestrator:1.0.0
POSTGRES_IMAGE=motherbase-postgres:1.0.0

# Production setup resolves these external tags and persists repository digests.
MINIO_IMAGE=alpine/minio@sha256:<digest>
MINIO_MC_IMAGE=quay.io/minio/mc@sha256:<digest>
DOCKER_CLI_IMAGE=docker@sha256:<digest>

# Optional read-only release channel used by the Console version card.
UPDATE_CHECK_URL=
