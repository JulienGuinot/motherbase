# Production setup resolves and persists immutable repository digests.
TRAEFIK_IMAGE=traefik@sha256:<digest>
TRAEFIK_DOCKER_PROXY_IMAGE=nginx@sha256:<digest>

# Email used by Let's Encrypt for cert expiry warnings.
ACME_EMAIL=you@example.com

# Optional: hostname for the Traefik dashboard (e.g. traefik.example.com).
# Leave empty to disable. Point a DNS A record at this VPS first.
TRAEFIK_DASHBOARD_HOST=

# Basic-auth credentials for the dashboard.
# Generate with:  htpasswd -nbB admin 'your-password' | sed -e 's/\$/\$\$/g'
# (the doubled $$ is required so docker-compose doesn't interpolate)
TRAEFIK_DASHBOARD_AUTH=

# DNS-01 challenge: required when your base domain is itself a subdomain
# (e.g. DOMAIN=test.example.com → projects land at foo.test.example.com, which
# Let's Encrypt refuses to cert via HTTP-01). Leave blank if not needed.
#
# Provider: see https://doc.traefik.io/traefik/https/acme/#providers
DNS_CHALLENGE_PROVIDER=
GODADDY_API_KEY=
GODADDY_API_SECRET=
