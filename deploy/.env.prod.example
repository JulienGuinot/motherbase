# =====================================================================
# Per-project production environment.
# Copy to .env.prod at the repo root and fill in. NEVER commit .env.prod.
# Generate secrets with:
#   openssl rand -hex 32                         # JWT_SECRET, POSTGRES_PASSWORD
#   openssl rand -base64 32                      # CONFIG_ENCRYPTION_KEY
# =====================================================================

# --- Identity & routing ---
# Lowercase, alphanumeric + dashes. Used as the docker-compose project name
# (namespaces all containers/volumes/networks for this project).
COMPOSE_PROJECT_NAME=projet-a

# Public hostname for the API. DNS A record must point at the VPS.
PROJECT_DOMAIN=projet-a.example.com

# Public hostname for the S3 (MinIO) public bucket. Recommended: storage subdomain.
STORAGE_DOMAIN=storage.projet-a.example.com

# Optional: hostname for the MinIO admin console. Leave empty to disable.
MINIO_CONSOLE_DOMAIN=

# Comma-separated CORS origins. Defaults to the project domain alone.
# Add your frontend URLs here, e.g. https://app.example.com,https://www.example.com
CORS_ORIGINS=

# --- Console-managed runtime ---
# Shared prebuilt API image the Console runs for every project.
API_IMAGE=motherbase-api:latest

# Service token the Console uses to reach this project's /api/admin.
# Auto-generated per project by the Console/manifest tooling.
PLATFORM_SERVICE_TOKEN=

# --- Secrets (REQUIRED) ---
POSTGRES_PASSWORD=
JWT_SECRET=
CONFIG_ENCRYPTION_KEY=

MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=

# --- Storage ---
S3_BUCKET=uploads
S3_REGION=us-east-1

# --- Token lifetimes (optional, sane defaults) ---
ACCESS_TOKEN_EXP_MIN=15
REFRESH_TOKEN_EXP_DAYS=30

# --- SMTP (optional, leave blank to disable email login / password resets) ---
EMAIL_SMTP_HOST=
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=

# --- Push notifications (optional) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

APNS_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_PRODUCTION=true

# --- Reverse proxy ---
# Traefik terminates TLS in front of every project (see deploy/traefik), so the
# app must trust exactly one hop to read the real client IP. Without this, rate
# limiting keys on Traefik's IP and all clients share one bucket.
TRUST_PROXY=1

# --- Console ---
CONSOLE_SQL_ENABLED=true
CONSOLE_LOG_BUFFER_SIZE=500

# Durable log history (platform.request_logs), overridable in Studio under
# Settings > Logs. Without it the Logs screen only ever sees the in-memory
# buffer above: no history past a restart, and none past CONSOLE_LOG_BUFFER_SIZE lines.
LOG_PERSISTENCE_ENABLED=true
LOG_RETENTION_DAYS=7
LOG_MAX_ROWS=2000000
