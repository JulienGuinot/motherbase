engine-strict=true
# @better-auth/{passkey,sso,api-key} pull better-call, whose peerOptional zod@^4
# conflicts with the project's pinned zod@^3. The peer is optional and unused, so
# resolve leniently for every npm command (install / ci / prune), CI, Docker and
# a fresh `npm i` all rely on this.
legacy-peer-deps=true

