{
  /* Type-level tests (`*.test-d.ts`). The package tsconfig only covers `src`
     because that is what ships; this one adds `tests` so `vitest --typecheck`
     compiles the assertions under the same strictness as the build. */
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    /* `rootDir`/`outDir` exist for the shipped build; nothing is emitted here,
       and keeping `rootDir: src` would reject every file under `tests`. */
    "rootDir": ".",
    "declaration": false,
    "declarationMap": false,
    "types": ["node"]
  },
  "include": ["src", "tests"]
}
