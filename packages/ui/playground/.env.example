# API URL and public project key from your Motherbase instance.
# Never put an mb_secret_ key in a VITE_ variable.
VITE_MOTHERBASE_URL=https://your-motherbase.example
VITE_MOTHERBASE_KEY=mb_publishable_your-key

# Enable only methods configured on that project.
VITE_MOTHERBASE_PROVIDERS=
VITE_MOTHERBASE_PASSKEYS=false
