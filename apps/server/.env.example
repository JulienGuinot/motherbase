PORT= # Example: 5001

# PostgreSQL connection string used by Prisma
POSTGRES_PORT= # Example: 55432
DATABASE_URL= # Example: postgresql://postgres:postgres@localhost:55432/app?schema=public

JWT_SECRET= # Required, min 32 chars. Generate: openssl rand -hex 32

# Base64 32-byte key encrypting Studio-managed secrets (SMTP, OAuth...) at rest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CONFIG_ENCRYPTION_KEY= # Example: 3pX1...base64...32bytes==

STATIC_PATH= # Example: uploads
USER_PATH= # Example: users

EMAIL_SMTP_USERNAME=  # Example: name@gmail.com
EMAIL_SMTP_PASSWORD=  # Example: jdsv feyb eheg edkn
EMAIL_SMTP_HOST= # Example: smtp.gmail.com


BASE_HOST= # Example: localhost:5001

# Interface to bind. Empty derives it from NODE_ENV: 0.0.0.0 in production,
# 127.0.0.1 otherwise: outside production, error responses carry stack traces,
# so the default keeps them off the network. Set it only for a VM or remote box.
BIND_HOST= # Example: 0.0.0.0

# Comma-separated allowed CORS origins. Leave empty to allow all (dev only).
CORS_ORIGINS= # Example: http://localhost:3000,https://app.example.com

# Storage (Phase 2). local = filesystem, s3 = S3-compatible (AWS S3, MinIO, R2...)
STORAGE_DRIVER= # local | s3
MINIO_PORT= # Example: 59000
MINIO_CONSOLE_PORT= # Example: 59001
S3_ENDPOINT= # Example: http://localhost:59000 (MinIO). Leave empty for AWS S3
S3_REGION= # Example: us-east-1
S3_ACCESS_KEY_ID= # Example: minioadmin
S3_SECRET_ACCESS_KEY= # Example: minioadmin
S3_BUCKET= # Example: uploads
S3_PUBLIC_URL= # Public base URL for public objects. Example: http://localhost:59000/uploads
S3_PRESIGN_ENDPOINT= # Where clients reach the S3 API, if not S3_ENDPOINT (MinIO behind a proxy). Signed URLs are signed for this host.

# Push notifications (Phase 3): leave blank to keep a provider disabled.
# Firebase Cloud Messaging (Android / Web): from a service account JSON.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY= # Paste the key with literal \n for newlines, wrapped in quotes
# Apple Push Notification service (iOS): from a .p8 auth key.
APNS_KEY= # Contents of the .p8 file (with \n newlines)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID= # Your app's bundle id, e.g. com.example.app
APNS_PRODUCTION= # true in production, false for the sandbox

# --- Studio dashboard ---
# Enable the in-dashboard SQL console (keep false in production unless needed).
CONSOLE_SQL_ENABLED=true
# How many recent log lines the dashboard keeps in memory.
CONSOLE_LOG_BUFFER_SIZE=500

# Durable log history (platform.request_logs), overridable in Studio under
# Settings > Logs. Without it the Logs screen only ever sees the in-memory
# buffer above: no history past a restart, and none past CONSOLE_LOG_BUFFER_SIZE lines.
LOG_PERSISTENCE_ENABLED=true
LOG_RETENTION_DAYS=7
LOG_MAX_ROWS=2000000

# --- Doctor / Shield ---
# How many reverse-proxy hops to trust for the client IP. Rate limiting keys on
# req.ip, so behind Traefik/nginx/a cloud LB this MUST be set (1 = one proxy) or
# every client shares the proxy's IP and one caller exhausts the limit for all.
# Leave empty when the app is exposed directly: trusting X-Forwarded-For with no
# proxy in front lets any client forge its IP and bypass limits.
# Accepts a hop count, "loopback", or a comma-separated IP/CIDR list.
TRUST_PROXY=
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_GLOBAL_MAX=1000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_REST_READ_MAX=300
RATE_LIMIT_REST_WRITE_MAX=120
RATE_LIMIT_EDGE_MAX=60

# Edge invoke is private by default. To open one function (a webhook receiver),
# mark it Public in the console. True opens every function at once.
EDGE_PUBLIC_INVOKE_ENABLED=false
# Server-to-server calls use a secret project API key (Studio > API keys).
# This optional static token, sent as x-motherbase-edge-token, also works.
EDGE_INVOKE_TOKEN=
# Edge functions run in the private Deno sidecar (deploy/edge-runtime). The
# token must match the edge-runtime service. Locally: `npm run edge-runtime`.
EDGE_RUNTIME_URL=http://localhost:9000
EDGE_RUNTIME_TOKEN=dev-edge-runtime-token
# This API as the sidecar reaches it (sendMail() posts back here).
EDGE_RUNTIME_CALLBACK_URL=http://localhost:5001
# Stored secrets are injected into edge functions as `env.NAME`. Set to false
# to withhold them: note that Console integrations (Stripe, Resend, Twilio)
# are written against `env.*` and stop working when it is off.
EDGE_SECRETS_ENABLED=true

# Local backup output directory, relative to the project root unless absolute.
BACKUP_DIR=backups

# Directory for the assistant's own SQLite thread store, relative to the
# project root unless absolute.
AI_DATA_DIR=data

# Operational logs are purged daily by default to prevent unbounded growth.
# Set DATA_RETENTION_ENABLED=false to disable, or override these bounded defaults.
DATA_RETENTION_ENABLED=true
DATA_RETENTION_CRON="15 4 * * *"
WEBHOOK_DELIVERY_RETENTION_DAYS=30
EDGE_FUNCTION_LOG_RETENTION_DAYS=30
DATA_RETENTION_BATCH_SIZE=500
DATA_RETENTION_MAX_BATCHES=20

# Directory containing the Postgres client binaries (pg_dump / psql) used by the
# Backups and Supabase-import features. Leave empty to resolve them from PATH
# (the Docker image installs postgresql-client). Set this on native Windows/macOS
# dev machines where the tools live outside PATH, e.g.:
#   Windows: C:\Program Files\PostgreSQL\16\bin
#   macOS (Homebrew): /opt/homebrew/opt/postgresql@16/bin
PG_BIN_DIR=

# AI assistant, organization-wide default. The Console writes these into each
# project's .env.prod when an operator sets a key for the organization; a
# standalone deployment sets them by hand. A project that saves its own
# `ai.assistant` settings overrides them entirely.
AI_ASSISTANT_ENABLED=false
AI_PROVIDER=          # anthropic | openai | gemini | deepseek | qwen | glm | moonshot | mistral | xai | groq | openrouter | compatible
AI_MODEL=             # blank uses the provider default
AI_API_KEY=
AI_BASE_URL=          # required when AI_PROVIDER=compatible; overrides a named provider's endpoint
