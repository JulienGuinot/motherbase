{
  "name": "@motherbase/server",
  "version": "1.0.0",
  "private": true,
  "description": "Motherbase API + Platform Console server.",
  "main": "dist/app.js",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "nodemon app.ts",
    "console:dev": "nodemon console/server.ts",
    "console:start": "node ./dist/console/server.js",
    "start": "node ./dist/app.js",
    "build": "node scripts/clean-dist.cjs && prisma generate && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:contracts": "npm run build -w @motherbase/contracts && npm run build -w @motherbase/client && vitest run tests/sdk-server-contract.integration.test.ts",
    "smoke:critical": "bash ./tests/critical-flows-smoke.sh",
    "test:watch": "vitest",
    "lint": "eslint .",
    "swagger": "ts-node ./swagger.ts",
    "docs:routes": "ts-node ./scripts/generate-route-docs.ts",
    "docs:settings": "ts-node ./scripts/generate-settings-docs.ts",
    "audit:ci": "npm audit --omit=dev --audit-level=high",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "ts-node prisma/seed.ts"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.620.0",
    "@aws-sdk/s3-request-presigner": "^3.620.0",
    "@better-auth/api-key": "^1.7.14",
    "@better-auth/passkey": "^1.7.14",
    "@better-auth/sso": "^1.7.14",
    "@motherbase/ai": "*",
    "@motherbase/contracts": "^1.0.0",
    "@parse/node-apn": "^8.2.0",
    "@prisma/client": "^5.18.0",
    "@tus/file-store": "^2.1.1",
    "@tus/s3-store": "^2.0.7",
    "@tus/server": "^2.4.5",
    "@tus/utils": "^0.7.1",
    "argon2": "^0.41.1",
    "awilix": "^10.0.1",
    "awilix-express": "^9.0.1",
    "bcryptjs": "^3.0.3",
    "better-auth": "^1.7.14",
    "better-sqlite3": "^12.11.1",
    "body-parser": "^1.19.0",
    "cookie-parser": "^1.4.5",
    "cors": "^2.8.5",
    "dotenv": "^8.6.0",
    "esbuild": "^0.28.2",
    "execa": "^8.0.1",
    "express": "^4.17.1",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.1.0",
    "firebase-admin": "^14.0.0",
    "helmet": "^7.1.0",
    "http-proxy": "^1.18.1",
    "jose": "^6.2.3",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.16",
    "pg": "^8.21.0",
    "prisma": "^5.18.0",
    "sharp": "^0.35.5",
    "socket.io": "^4.7.4",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@motherbase/client": "^2.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/http-proxy": "^1.17.17",
    "@types/js-yaml": "^4.0.9",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.17",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.14",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^9.0.8",
    "eslint": "^9.39.0",
    "globals": "^15.15.0",
    "js-yaml": "^4.1.0",
    "nodemon": "^3.1.14",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.2",
    "typescript-eslint": "^8.64.0",
    "vitest": "^5.0.0"
  }
}
